<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" styleClass="backdrop">
    <VBox styleClass="card,startup-card" alignment="CENTER" spacing="14"
          maxWidth="460" maxHeight="-Infinity">
        <Label text="Sistema Gimnasio" styleClass="title"/>
        <ProgressIndicator fx:id="progress" prefWidth="40" prefHeight="40"/>
        <Label fx:id="status" styleClass="subtitle" wrapText="true"/>
        <Label fx:id="detail" styleClass="startup-detail" wrapText="true"/>
        <HBox fx:id="actions" spacing="8" alignment="CENTER">
            <Button text="Salir" onAction="#exit" cancelButton="true"/>
            <Button fx:id="retryButton" text="Reintentar" onAction="#retry" defaultButton="true"
                    styleClass="primary"/>
        </HBox>
    </VBox>
</StackPane>
